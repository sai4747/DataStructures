vector<int> twoSum(vector<int>& nums, int target) {
        int l = nums.size();
        vector<int>result;
        for(int i = 0; i < l ; i++)
        {
            for(int j = i+1; j < l; j++)
            {
                if(target == nums[i]+nums[j])
                {
                    result.push_back(i);
                    result.push_back(j);
                }
            }            
        }
        return result;
    }